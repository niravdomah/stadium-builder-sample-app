{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch NewApp",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/app-backend/NewApp/bin/Debug/net10.0/NewApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/app-backend/NewApp",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}